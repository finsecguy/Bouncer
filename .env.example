# Copy to .env and fill in. .env is gitignored; never commit secrets.

# SQLite database path (created on first run).
BOUNCER_DB_PATH=data/bouncer.db

# --- Rate limiting (conservative defaults) ---
BOUNCER_RATE_PER_HOST=2.0        # sustained requests/sec per host
BOUNCER_RATE_PER_HOST_BURST=4    # burst bucket size per host
BOUNCER_RATE_GLOBAL=5.0          # sustained requests/sec across all hosts
BOUNCER_RATE_GLOBAL_BURST=10     # burst bucket size global

# --- HTTP ---
BOUNCER_HTTP_TIMEOUT=15.0
BOUNCER_USER_AGENT=bouncer/0.1

# --- IDOR validator: two authenticated sessions from the SAME program ---
# Provide session cookies/headers as JSON objects. Account A performs the
# replay; Account B's object id is substituted. Leave blank to skip IDOR.
BOUNCER_IDOR_SESSION_A={"Cookie": "session=REPLACE_A"}
BOUNCER_IDOR_SESSION_B={"Cookie": "session=REPLACE_B"}

# --- Recon (milestone 2) ---
# External ProjectDiscovery tools, wrapped via subprocess. Override the path if
# the binary isn't on PATH, or to disambiguate the 'httpx' name collision with
# the Python httpx library CLI (bouncer verifies PD-httpx by its -version output).
BOUNCER_SUBFINDER_BIN=subfinder
BOUNCER_HTTPX_BIN=httpx
BOUNCER_KATANA_BIN=katana
BOUNCER_RECON_TIMEOUT=120
BOUNCER_KATANA_MAX_DEPTH=2
BOUNCER_CANDIDATES_DIR=candidates

# --- LLM provider for candidate-generation reasoning (reasoning steps ONLY;
# the chosen endpoint is never a target, so it is not scope-gated). Keys are
# never logged. Run `bouncer setup` to configure these interactively. ---
# provider: anthropic | openai | self_hosted
BOUNCER_LLM_PROVIDER=anthropic

# Used when provider=anthropic:
BOUNCER_ANTHROPIC_API_KEY=
BOUNCER_ANTHROPIC_MODEL=claude-sonnet-5
BOUNCER_ANTHROPIC_MAX_TOKENS=2048

# Used when provider=openai or self_hosted:
BOUNCER_OPENAI_API_KEY=
BOUNCER_OPENAI_MODEL=gpt-4.1-mini
# Required for self_hosted (e.g. http://localhost:11434/v1 for Ollama);
# optional for provider=openai (defaults to OpenAI's real endpoint):
BOUNCER_OPENAI_BASE_URL=
BOUNCER_OPENAI_MAX_TOKENS=2048
