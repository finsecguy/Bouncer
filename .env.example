# Copy to .env and fill in. .env is gitignored; never commit secrets.

# SQLite database path (created on first run).
BBV_DB_PATH=data/bbv.db

# --- Rate limiting (conservative defaults) ---
BBV_RATE_PER_HOST=2.0        # sustained requests/sec per host
BBV_RATE_PER_HOST_BURST=4    # burst bucket size per host
BBV_RATE_GLOBAL=5.0          # sustained requests/sec across all hosts
BBV_RATE_GLOBAL_BURST=10     # burst bucket size global

# --- HTTP ---
BBV_HTTP_TIMEOUT=15.0
BBV_USER_AGENT=bbv-validator/0.1

# --- IDOR validator: two authenticated sessions from the SAME program ---
# Provide session cookies/headers as JSON objects. Account A performs the
# replay; Account B's object id is substituted. Leave blank to skip IDOR.
BBV_IDOR_SESSION_A={"Cookie": "session=REPLACE_A"}
BBV_IDOR_SESSION_B={"Cookie": "session=REPLACE_B"}

# --- Recon (milestone 2) ---
# External ProjectDiscovery tools, wrapped via subprocess. Override the path if
# the binary isn't on PATH, or to disambiguate the 'httpx' name collision with
# the Python httpx library CLI (bbv verifies PD-httpx by its -version output).
BBV_SUBFINDER_BIN=subfinder
BBV_HTTPX_BIN=httpx
BBV_KATANA_BIN=katana
BBV_RECON_TIMEOUT=120
BBV_KATANA_MAX_DEPTH=2
BBV_CANDIDATES_DIR=candidates

# --- Claude API (reasoning steps ONLY; goes to api.anthropic.com, never a
# target, so it is not scope-gated). Key is never logged. ---
BBV_ANTHROPIC_API_KEY=
BBV_ANTHROPIC_MODEL=claude-sonnet-5
BBV_ANTHROPIC_MAX_TOKENS=2048
